{
  "name": "scene-engine-workspace",
  "version": "0.18.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10 <12"
  },
  "workspaces": [
    "js/packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces && npm run typecheck && npm run test:resource-lifecycle",
    "benchmark:communication": "uv run python scripts/benchmark_python_js_communication.py",
    "benchmark:display": "node scripts/benchmark_display_runtime_scale.mjs",
    "benchmark:display:browser": "node scripts/benchmark_display_browser.mjs",
    "test:resource-lifecycle": "node --expose-gc scripts/verify_display_leaks.mjs",
    "typecheck": "tsc -p js/types/tsconfig.json"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
